{
    "manifest_version": 3,
    "name": "CAPTCHA Autofill",
    "version": "1.0.1",
    "permissions": [
        "storage",
        "scripting",
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://smartcsg.karnataka.gov.in/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
